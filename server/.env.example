# AuraMart Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/auramart

# Authentication Secrets
JWT_SECRET=auramart-ultra-secure-jwt-secret-key-2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=auramart-cookie-secret-key-2026

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Razorpay Payment Gateway (Indian Payments)
# Get your test keys from https://dashboard.razorpay.com/#/access/api_keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# AURA AI Shopping Assistant (Google Gemini API)
# Get a free key at https://aistudio.google.com/
# If left blank, AURA AI automatically runs in its intelligent catalog-grounded rule fallback mode.
GEMINI_API_KEY=

# Initial Administrator Account (Configured on database seed)
ADMIN_EMAIL=admin@auramart.com
ADMIN_PASSWORD=Admin@AuraMart2026

